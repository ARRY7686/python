+    # -- partial event at end of stream (no trailing newline) ----------------
+
+    def test_iter_resp_lines_partial_buffer_at_stream_end(self):
+        """Data buffered without a trailing newline must not silently vanish.
+
+        A well-behaved Kubernetes API server always terminates events with \\n,
+        but a server that closes the connection mid-event should not silently
+        drop the partial content without giving iter_resp_lines a chance to
+        flush.  This test verifies that a complete JSON object delivered in
+        chunks without a trailing newline is still yielded.
+        """
+        # Complete JSON, but no trailing newline — simulates a server that
+        # closes the connection immediately after the last byte of the object.
+        raw = b'{"type":"ADDED","object":{"metadata":{"name":"final","resourceVersion":"99"}}}'
+        # Split into three chunks with no trailing \n anywhere
+        resp = _fake_resp([raw[:30], raw[30:60], raw[60:]])
+        lines = [l for l in iter_resp_lines(resp) if l]
+        # The implementation must flush the buffer and yield the line.
+        self.assertEqual(1, len(lines))
+        parsed = json.loads(lines[0])
+        self.assertEqual('final', parsed['object']['metadata']['name'])
